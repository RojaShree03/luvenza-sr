PORT=5000
MONGODB_URI=YOUR_MONGODB_URI
JWT_SECRET=YOUR_JWT_SECRET
FRONTEND_URL=http://localhost:5173
# Use the Test Mode API keys while developing; keep the key secret server-side.
RAZORPAY_KEY_ID=YOUR_RAZORPAY_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_TEST_WEBHOOK_SECRET
PAYMENT_RESERVATION_MS=45000
# Set to 1 only when running npm run seed:demo against a development database.
ALLOW_DEMO_SEED=0
